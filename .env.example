# =============================================================================
# ProposalFast environment
# Copy to .env and fill in. Never commit real secrets.
#
# Classification (every variable below has exactly one):
#   REQUIRED            — app will not boot locally or in production without it
#   OPTIONAL            — feature stays off or uses a safe fallback when empty
#   DEVELOPMENT ONLY    — never enable in production
#   PRODUCTION          — required for that live product surface (not a mock)
# =============================================================================

# --- REQUIRED ----------------------------------------------------------------
# PostgreSQL (local Docker, Neon, or Supabase). Not a mock database.
# CLASS: REQUIRED
DATABASE_URL="postgresql://proposalfast:proposalfast_dev@localhost:5432/proposalfast"

# Auth.js session signing secret. Generate with: openssl rand -base64 32
# CLASS: REQUIRED
AUTH_SECRET="replace-with-32-plus-char-secret"

# Canonical origin used in emails, OG tags, Stripe redirects, and Auth.js.
# Production must be https://proposalfast.ai (no trailing slash).
# CLASS: REQUIRED
AUTH_URL="http://localhost:43127"
# CLASS: REQUIRED
NEXT_PUBLIC_APP_URL="http://localhost:43127"

# --- Email (Resend) ----------------------------------------------------------
# Without RESEND_API_KEY, ConsoleEmailAdapter logs in development only.
# Production and Vercel production refuse to send without a real Resend key.
# FROM must be a verified-domain address, either:
#   noreply@proposefast.com
#   ProposalFast <noreply@proposefast.com>
# Bare names without an address, empty values, and unverified domains are rejected.
# Recipients may use plus-aliases (you+tag@gmail.com); those are valid.
# CLASS: PRODUCTION
RESEND_API_KEY=""
# CLASS: PRODUCTION
RESEND_FROM_EMAIL="ProposalFast <noreply@proposefast.com>"

# --- AI (OpenAI) -------------------------------------------------------------
# Generation / rewrite / QC. Missing key → real error, never a canned draft.
# CLASS: PRODUCTION
OPENAI_API_KEY=""
# CLASS: OPTIONAL
OPENAI_MODEL="gpt-4.1"
# CLASS: OPTIONAL
OPENAI_MODEL_FAST="gpt-4.1-mini"

# --- Payments (Stripe) -------------------------------------------------------
# Webhooks are the only writer of paid Subscription rows.
# Production webhook URL: https://proposalfast.ai/api/webhooks/stripe
# CLASS: PRODUCTION
STRIPE_SECRET_KEY=""
# CLASS: PRODUCTION
STRIPE_WEBHOOK_SECRET=""
# Publishable key is the only Stripe value allowed in the browser bundle.
# CLASS: OPTIONAL
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# CLASS: PRODUCTION
STRIPE_PRICE_PRO_MONTHLY=""
# CLASS: PRODUCTION
STRIPE_PRICE_PRO_YEARLY=""
# CLASS: PRODUCTION
STRIPE_PRICE_BUSINESS_MONTHLY=""
# CLASS: PRODUCTION
STRIPE_PRICE_BUSINESS_YEARLY=""
# Optional trial length on new Checkout subscriptions (1–30).
# CLASS: OPTIONAL
STRIPE_TRIAL_DAYS=""

# --- Object storage (S3 or Cloudflare R2) ------------------------------------
# Used for generated PDFs and any stored files. Throws if used without keys.
# CLASS: PRODUCTION
S3_BUCKET=""
# CLASS: OPTIONAL
S3_REGION="auto"
# CLASS: PRODUCTION
S3_ACCESS_KEY_ID=""
# CLASS: PRODUCTION
S3_SECRET_ACCESS_KEY=""
# Set for R2 or any S3-compatible endpoint. Leave empty for AWS S3.
# CLASS: OPTIONAL
S3_ENDPOINT=""
# CLASS: OPTIONAL
S3_PUBLIC_URL=""

# --- Optional: Google OAuth --------------------------------------------------
# CLASS: OPTIONAL
GOOGLE_CLIENT_ID=""
# CLASS: OPTIONAL
GOOGLE_CLIENT_SECRET=""

# --- Jobs (Inngest) ----------------------------------------------------------
# Background AI, email, PDF upload, and follow-up sends.
# CLASS: OPTIONAL
INNGEST_EVENT_KEY=""
# CLASS: OPTIONAL
INNGEST_SIGNING_KEY=""

# --- Platform admin ----------------------------------------------------------
# Comma-separated emails. Also User.platformAdmin. Org Admin is not enough.
# CLASS: OPTIONAL
PLATFORM_ADMIN_EMAILS=""

# --- Optional: Sentry (no-op when unset) -------------------------------------
# CLASS: OPTIONAL
SENTRY_DSN=""

# --- Optional: Upstash Redis rate limits -------------------------------------
# Falls back to in-process memory when unset.
# CLASS: OPTIONAL
UPSTASH_REDIS_REST_URL=""
# CLASS: OPTIONAL
UPSTASH_REDIS_REST_TOKEN=""

# --- Seed --------------------------------------------------------------------
# Local-only. Production and Vercel production (`NODE_ENV` / `VERCEL_ENV`)
# never load demo users, even if this is set to "true".
# CLASS: DEVELOPMENT ONLY
SEED_SAMPLE_DATA="true"
