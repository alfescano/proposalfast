# =============================================================================
# ProposalFast environment
# Copy to .env and fill in. Keys marked REQUIRED are needed to boot locally.
# Keys marked PRODUCT are required for that product surface (AI, pay, email, files).
# Never commit real secrets.
# =============================================================================

# --- REQUIRED to run locally -------------------------------------------------
# PostgreSQL connection string (Neon / Supabase / local Docker all work)
DATABASE_URL="postgresql://proposalfast:proposalfast_dev@localhost:5432/proposalfast"

# Auth.js session signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-32-plus-char-secret"

# Canonical origin used in emails, OG tags, Stripe redirects, and Auth.js
# In production this must be https://proposalfast.com (or your chosen host)
AUTH_URL="http://localhost:43127"
NEXT_PUBLIC_APP_URL="http://localhost:43127"

# --- Email (Resend) — PRODUCT: verification, reset, send proposal ------------
# Without RESEND_API_KEY, the ConsoleEmailAdapter logs messages in development.
# Production refuses to start email sends without a real Resend key.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="ProposalFast <noreply@proposalfast.com>"

# --- AI (OpenAI) — PRODUCT: generate / rewrite / QC --------------------------
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1"
OPENAI_MODEL_FAST="gpt-4.1-mini"

# --- Payments (Stripe) — PRODUCT: subscriptions + proposal checkout ----------
# Webhooks are the source of truth. Point the Stripe endpoint to /api/webhooks/stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_YEARLY=""
STRIPE_PRICE_BUSINESS_MONTHLY=""
STRIPE_PRICE_BUSINESS_YEARLY=""
# Optional trial length applied on new Checkout subscriptions (1–30)
STRIPE_TRIAL_DAYS=""

# --- Object storage (S3 or Cloudflare R2) — PRODUCT: logos, PDFs, signatures -
S3_BUCKET=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Set for R2 or any S3-compatible endpoint. Leave empty for AWS S3.
S3_ENDPOINT=""
S3_PUBLIC_URL=""

# --- Optional: Google OAuth --------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Jobs (Inngest) — PRODUCT: AI pipeline, email, PDF, follow-ups -----------
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# --- Platform admin (comma-separated emails; also User.platformAdmin) --------
PLATFORM_ADMIN_EMAILS=""

# --- Optional: Sentry (no-op when unset) ------------------------------------
SENTRY_DSN=""

# --- Optional: Upstash Redis rate limits (falls back to in-process) ---------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Seed -------------------------------------------------------------------
# Set to "true" to load the clearly-dev-only demo user, clients, and proposals.
# Never enable in production.
SEED_SAMPLE_DATA="true"
